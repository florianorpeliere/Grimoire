# Pinned sources of the SRD 5.2.1 Markdown. Single place where the source commit is recorded.
# Read (sourced) by scripts/srd-download.sh and scripts/srd-validate.sh. Data only: no commands.
# See docs/srd-source.md before changing any value.

# Community conversion of the SRD 5.2.1 to Markdown (third party, no licence file: accepted risk).
SRD_REPO_URL="https://github.com/your5e/5e-srd-markdown.git"
SRD_COMMIT="f1f5060fd975aa2ffc3e4b336560ded479934d80"
# The cleaned single-file conversion, in document order, inside that repository.
SRD_REPO_FILE="dnd/521/SRD_CC_v5.2.1.md"

# SHA-256 of data/srd/SRD_CC_v5.2.1.md after the scripted cleanup. The download script fails if the
# result differs, which keeps the conversion reproducible.
SRD_MARKDOWN_SHA256="9ab36804df624c619a696a6d01cf59d11c7f62750dd5ee4813b6e9404ed24fe0"

# Official PDF, used only by the validation script.
SRD_PDF_URL="https://media.dndbeyond.com/compendium-images/srd/5.2/SRD_CC_v5.2.1.pdf"
SRD_PDF_SHA256="8974902d109d6e63672d7c490bde9ccf052410503d9cfa768237154fbc5e3d87"

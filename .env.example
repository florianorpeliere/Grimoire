# Copy to .env and adjust. Placeholder values only: never commit real credentials.
# Nothing loads this file automatically; export the variables in your shell
# (for example: set -a; . ./.env; set +a).

# PostgreSQL with pgvector. The project default port is 5433, so it does not
# clash with another PostgreSQL instance on the default port 5432.
# Use the grimoire_test database instead when running the tests.
DATABASE_URL=postgres://<user>@localhost:5433/grimoire?sslmode=disable

# Local Ollama server (used from a later story).
OLLAMA_HOST=http://localhost:11434

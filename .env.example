# Copy to .env and replace USER with your PostgreSQL role. Placeholder values
# only: never commit real credentials. Values are quoted so the file can be
# sourced by a shell (set -a; . ./.env; set +a); nothing loads it automatically.

# PostgreSQL with pgvector. The project default port is 5433, so it does not
# clash with another PostgreSQL instance on the default port 5432.
# Host, port and database name must be written explicitly in the URL.
# DATABASE_URL is for the application only; tests never read it.
DATABASE_URL='postgres://USER@localhost:5433/grimoire?sslmode=disable'

# Integration tests read this variable only, and only run against grimoire_test,
# whose schema they reset. Unset: they are skipped. Set: anything that prevents
# them from running (empty or incomplete URL, unreachable server, missing
# database, failed authentication, another database) fails them.
# Uncomment the next line to turn the integration tests on.
# TEST_DATABASE_URL='postgres://USER@localhost:5433/grimoire_test?sslmode=disable'

# Local Ollama server, for embeddings ("ingest srd"). Read from OLLAMA_HOST only;
# there is no default. It must be an http:// or https:// URL with a host.
# The model qwen3-embedding:0.6b must be pulled on it (ollama pull qwen3-embedding:0.6b).
OLLAMA_HOST='http://localhost:11434'

# Claude API key, for answer generation. Read from ANTHROPIC_API_KEY only; no
# other credential source is used. Every call costs money. Never commit a real
# key. Uncomment the next line and replace the placeholder to turn it on.
# ANTHROPIC_API_KEY='REPLACE_WITH_YOUR_KEY'

# Model used for answers when the caller does not name one. There is no default
# model in code (model choice is an open decision). Example: claude-sonnet-5-5.
# GRIMOIRE_MODEL='MODEL_ID'

# Opt-in test that makes one real, paid call to the Claude API (needs the two
# variables above). Unset: the test is skipped.
# GRIMOIRE_CLAUDE_LIVE_TEST='1'

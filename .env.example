# Copy to .env and replace USER with your PostgreSQL role. Placeholder values
# only: never commit real credentials. Values are quoted so the file can be
# sourced by a shell (set -a; . ./.env; set +a); nothing loads it automatically.

# PostgreSQL with pgvector. The project default port is 5433, so it does not
# clash with another PostgreSQL instance on the default port 5432.
# Host, port and database name must be written explicitly in the URL.
# Use the grimoire_test database instead when running the tests.
DATABASE_URL='postgres://USER@localhost:5433/grimoire?sslmode=disable'

# Local Ollama server (used from a later story).
OLLAMA_HOST='http://localhost:11434'
